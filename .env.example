# AUEVO Wallet (/wallet) — self-custodial embedded wallet with an AI agent.
# Privy owns the user's key end to end (email/phone/X login, embedded
# wallet, user-controlled recovery) — this app never stores or sees it.
# Get both from your app's dashboard at dashboard.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only — verifies the caller's Privy access token in every
# /api/wallet/* route (see src/lib/wallet/privy-server.ts). Never expose
# this to the browser.
PRIVY_APP_SECRET=

# AUEVO Wallet's in-app AI agent (Claude, read-only — it can see balances
# and chat, but has no tool access and cannot send a transaction). Get a
# key at console.anthropic.com. Uses the same SUPABASE_URL/
# SUPABASE_SERVICE_ROLE_KEY below for chat history, agent configs and the
# activity log (migration 0017_wallet_service.sql).
ANTHROPIC_API_KEY=

# Get a free key at https://helius.dev
HELIUS_API_KEY=

# From your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# /trade page — Jupiter Terminal swap widget (developers.jup.ag).
# Create a referral account at referral.jup.ag with a wallet you control,
# then paste its public key here. Fee is in basis points (15 = 0.15%).
# Without these set, the widget still works, just collects no fee.
NEXT_PUBLIC_JUPITER_REFERRAL_ACCOUNT=
NEXT_PUBLIC_JUPITER_FEE_BPS=15

# Optional: a paid Solana RPC endpoint for the /trade widget to use
# (defaults to the public mainnet endpoint, which is rate-limited).
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=

# Robinhood Chain (EVM L2, chain ID 4663) — powers /scanner.
# Comma-separated; the first entry is primary, the rest are failovers.
# Defaults to the public endpoint (rate-limited, no SLA); move to a
# dedicated Alchemy/QuickNode endpoint here without a code change.
ROBINHOOD_RPC_URL=

# Display labels for the chain's gas token. Unverified against the live
# chain, and not used in any calculation — override if they read wrong.
ROBINHOOD_NATIVE_SYMBOL=
ROBINHOOD_NATIVE_NAME=

# Token scanner second opinions. Both default to the public endpoints;
# set a value to an empty string to switch that source off entirely.
# GoPlus Token Security covers Robinhood Chain (chain 4663) and is what
# simulates a buy/sell, which bytecode analysis cannot do.
GOPLUS_API_URL=
# Robinhood Chain's own Blockscout — indexed holder lists and contract
# verification status, neither of which the public RPC can serve.
BLOCKSCOUT_API_URL=

# Optional Blockscout key (dev.blockscout.com) — raises rate limits. The
# client discovers which Blockscout host answers for chain 4663, so
# BLOCKSCOUT_API_URL only needs setting to pin or override it.
BLOCKSCOUT_API_KEY=

# Quick Intel audit (quickintel.io) — a second source for whether
# liquidity is locked or burned, checked against docs.quickintel.io/
# developers/api-supported-chains as of 2026-09: Robinhood Chain (4663)
# is NOT on their supported-chains list yet, so this stays "unavailable"
# regardless of key/chain until they add it. Liquidity is answered today
# by GoPlus instead (see goplus.ts — its response already includes the
# LP token's own holder list, parsed for locked/burned share). Set the
# key below to future-proof for when Quick Intel adds this chain; no
# harm in leaving it unset.
QUICKINTEL_API_KEY=
QUICKINTEL_CHAIN=
# Only needed to override their documented defaults
# (https://api.quickintel.io/v1, header X-QKNTL-KEY).
QUICKINTEL_API_URL=
QUICKINTEL_AUTH_HEADER=

# WalletConnect (/app workspace) — optional. Without it, wallet connect
# still works via any injected wallet (MetaMask etc.); this adds the
# WalletConnect protocol on top. Get a project ID free at
# cloud.walletconnect.com/reown, no other config needed.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# DCA bot vault (/app/bots) — deliberately unset until someone runs
# contracts/script/deploy-dca.mjs with their own key. Never set this to
# a placeholder; the page reads its absence as "not deployed yet" and
# shows that honestly instead of pointing at a fake address.
NEXT_PUBLIC_DCA_VAULT_ADDRESS=

# AgentCreditPool (/credit) — same convention: deliberately unset until
# someone runs contracts/script/deploy-credit-pool.mjs with their own
# key, after deciding which identity registry to trust (see that
# script's own header and contracts/README.md). Never a placeholder.
NEXT_PUBLIC_CREDIT_POOL_ADDRESS=

# AgentIdentity for the AUEVO reputation protocol (Financial Agent
# League entry + Identity Proof category, see docs/AUEVO_PROTOCOL_SPEC.md
# §3a). Deliberately a SEPARATE registry from CREDIT_IDENTITY_ADDRESS
# above (same AgentIdentity.sol source, byte-identical bytecode, but its
# own deployed instance with its own agentId namespace) — Credit and the
# AUEVO reputation protocol are kept on independent registries on
# purpose, not unified. src/lib/auevo/identity.ts reads this as "not
# deployed yet" when unset, same convention.
NEXT_PUBLIC_AUEVO_IDENTITY_ADDRESS=

# Own chain indexer (api/cron/index-chain — see supabase/migrations/
# 0001_indexer.sql, which must be applied to the SUPABASE_URL project
# above before this does anything). Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests when
# it's set; generate any random string and set it both here and in
# Vercel's own env vars. Without it the route still works but accepts
# unauthenticated calls — fine for local testing, not for production.
CRON_SECRET=
# Absolute floor a checkpoint never scans below. Defaults to 0 (genesis)
# — set this to Uniswap V3's factory deployment block on Robinhood
# Chain, once known, to rule out pre-DEX blocks entirely. In practice
# INDEXER_LOOKBACK_BLOCKS below is almost always the binding limit, not
# this — this only matters once the two are close.
INDEXER_START_BLOCK=
# A checkpoint that's fallen more than this many blocks behind head
# jumps straight to `head - this` instead of continuing linearly from
# where it was — this chain does ~10 blocks/second, so crawling the
# full history (68M+ blocks and growing) on a once-a-day cron would
# take months just to reach anything current. Defaults to 2,000,000
# (~2.3 days of chain time). Raise it if the plan allows more frequent
# cron runs and more history is worth having; lower it if runs aren't
# catching up to head fast enough.
INDEXER_LOOKBACK_BLOCKS=
# eth_getLogs chunks (10,000 blocks each) per cron run, split evenly
# between pool discovery and swap scanning. Each run also stops itself
# on its own ~22s budget per scan regardless of this number — raise it
# only if runs are finishing well under that budget with room to spare.
INDEXER_MAX_CHUNKS_PER_RUN=

# Retention sweep for indexer_swaps (api/cron/prune-indexer, once a day) —
# the indexer above has no TTL of its own, and one row per on-chain swap
# scanned every 10 minutes is exactly what grew this table past a
# free-tier Supabase project's database-size quota in a matter of weeks.
# Every reader of this table already queries recency-ordered with a row
# LIMIT, so pruning rows older than this doesn't change what the app
# shows. Defaults to 30 days if unset.
INDEXER_SWAPS_RETENTION_DAYS=

# RWA marketplace swaps (/api/dex/*, RWA_SPEC.md phase 2) — the
# platform fee taken from a swap's OUTPUT via UniversalRouter's own
# PAY_PORTION command (see src/lib/rwa/dex/build.ts for why output, not
# input). Defaults to 30 bps if unset. Both must be set together to
# charge a fee at all; leaving AUEVO_FEE_RECIPIENT empty disables the
# fee entirely rather than sending it nowhere.
AUEVO_FEE_BPS=30
AUEVO_FEE_RECIPIENT=

# RWA asset registry + pricing (/api/cron/rwa-registry,
# /api/cron/rwa-prices — RWA_SPEC.md phase 1; supabase/migrations/
# 0003_rwa.sql through 0005_rwa_registry_state.sql must be applied
# first). Same CRON_SECRET above protects both routes.

# Reference-price provider for computing a token's premium/discount vs
# its real-world underlying (src/lib/rwa/reference-price.ts). "chainlink"
# is the real production choice (Ondo Finance and xStocks both use
# Chainlink Data Streams as their own official oracle) but isn't wired up
# yet — it needs a Data Streams subscription and API details this project
# hasn't set up. "twelvedata" is the working fallback (delayed quotes,
# free tier). Leave unset (or set to anything else) and premium is simply
# never computed — not guessed.
REFERENCE_PRICE_PROVIDER=
REFERENCE_PRICE_API_KEY=

# Absolute floor + jump-ahead window for the Robinhood Chain v4 pool
# registry scan (src/lib/rwa/run-registry.ts) — same shape and reasoning
# as INDEXER_START_BLOCK/INDEXER_LOOKBACK_BLOCKS above, just for the
# separate rwa_registry_state checkpoint.
RWA_REGISTRY_START_BLOCK=
RWA_REGISTRY_LOOKBACK_BLOCKS=
RWA_REGISTRY_MAX_CHUNKS_PER_RUN=

# Overrides the xStocks token-list URL src/lib/rwa/xstocks.ts fetches
# (github.com/backed-fi/cowswap-xstocks-tokenlist's tokenlist.json by
# default) — only needed to point at a mirror, or in tests.
XSTOCKS_TOKENLIST_URL=

# LI.FI swap/bridge aggregator (/api/lifi/*, /app/swap — RWA_SPEC.md
# phase 4). Optional: li.quest works unauthenticated too, a key just
# raises rate limits. AUEVO_FEE_BPS above is reused for LI.FI's own
# integrator fee param — see src/lib/rwa/lifi/client.ts's lifiFeeFraction()
# for why setting it doesn't by itself mean Auevo actually collects
# anything (LI.FI only pays out to a *verified* integrator, which this
# project isn't registered as yet).
LIFI_API_KEY=
# Only needed to point at a mirror, or in tests (li.quest itself is
# blocked from this sandbox's own egress, confirmed 2026-09-26).
LIFI_API_URL=

# Used by Phase 5's risk-scoring cron (api/cron/rwa-risk, src/lib/rwa/
# evm-clients.ts) to read contract state on the non-Robinhood chains
# rwa_tokens lists (Ethereum, Base, BNB, Arbitrum, HyperEVM — see
# src/lib/rwa/lifi/chains.ts). Optional: each chain falls back to its own
# wagmi/chains-bundled public RPC when unset, fine for the occasional-scan
# volume a once-a-day cron needs. The browser-side wagmi client (src/lib/
# wagmi.ts) is unrelated and always uses the public RPCs — these vars are
# server-only.
RPC_ETHEREUM=
RPC_BASE=
RPC_BSC=
RPC_ARBITRUM=
RPC_HYPEREVM=

# Reserved for a future Solana wallet-adapter integration — RWA_SPEC.md
# phase 4 explicitly allows deferring Solana support to the end of the
# phase, and this build does not wire it up yet (LI.FI bridging in/out of
# Solana needs a Solana-side signer, not an EVM one, which is a separate
# piece of work from everything else in src/lib/rwa/lifi/).
SOLANA_RPC_URL=

# Phase 8's /app/lend (Kamino xStocks rates). Left unset on purpose: this
# environment couldn't reach api.kamino.finance to confirm the actual
# on-chain pubkey of Kamino's xStocks lending market (see
# src/lib/rwa/kamino.ts's own doc comment) — set this only after
# confirming it yourself against Kamino's own docs/UI. Unset, /app/lend
# says so plainly instead of showing fabricated rates.
KAMINO_XSTOCKS_MARKET_PUBKEY=

# "Private swap" (MEV-protected submission) on the native swap panel.
# Left unset on purpose: this environment has no verified private/MEV-
# protected RPC endpoint for Robinhood Chain (chain 4663) — the
# well-known public options (Flashbots Protect, MEV Blocker) are
# Ethereum-mainnet-specific and don't apply here. Set this only to an
# endpoint you've confirmed actually serves Robinhood Chain — see
# src/lib/rwa/private-swap.ts's own doc comment, including why most
# browser wallets can't use this even once it's set.
PRIVATE_SWAP_RPC_URL=

# Phase 8's alerts (web + Telegram). BOT_TOKEN from @BotFather; SECRET is
# a random string you choose, checked against Telegram's own
# X-Telegram-Bot-Api-Secret-Token header (set via setWebhook's
# secret_token param) so a stranger who finds the webhook URL can't feed
# it fake updates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# The bot's own @username (no leading @), shown in the "link Telegram" UI
# so a user knows which bot to message — purely cosmetic, not used to
# call the Bot API (that always goes through TELEGRAM_BOT_TOKEN).
TELEGRAM_BOT_USERNAME=


# Private Swap (/app/private-swap) — Houdini Swap API credentials.
# Keep these server-only; never prefix with NEXT_PUBLIC_.
# Obtain both from your Houdini partner account before enabling the integration.
HOUDINI_API_KEY=
HOUDINI_API_SECRET=

# AUEVO Wallet's Swap action (/wallet, src/lib/wallet/zerox.ts) — 0x Swap
# API v2, AllowanceHolder flow (standard ERC20 approve(), no EIP-712
# signing, so it reuses the same useSendTransaction path Send already
# uses). Get a free key at 0x.org/pricing. Server-only — the quote route
# proxies this so the key is never exposed to the browser.
ZEROX_API_KEY=

# GitHub API token for the "Work" Proof category — used by
# src/lib/social/verify-work.ts (polls a committed PR's merge state) and
# src/lib/auevo/work-board.ts (syncs the /proofs/work "open issues"
# discovery board from GitHub's Search API). Entirely optional: unset,
# both features still work against GitHub's unauthenticated rate limit
# (fine at this app's low call volume — one poll pass / one search call
# per cron run, not per page load), they just degrade gracefully (fewer
# issues synced, pending commitments simply retried next run) rather
# than erroring. Set a fine-grained PAT with no scopes (public read-only
# access is the default) to raise the limit. Never required in
# production — do not let its absence block a deploy.
GITHUB_TOKEN=
