# Get a free key at https://helius.dev
HELIUS_API_KEY=

# From your Supabase project: Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# /trade page — Jupiter Terminal swap widget (developers.jup.ag).
# Create a referral account at referral.jup.ag with a wallet you control,
# then paste its public key here. Fee is in basis points (15 = 0.15%).
# Without these set, the widget still works, just collects no fee.
NEXT_PUBLIC_JUPITER_REFERRAL_ACCOUNT=
NEXT_PUBLIC_JUPITER_FEE_BPS=15

# Optional: a paid Solana RPC endpoint for the /trade widget to use
# (defaults to the public mainnet endpoint, which is rate-limited).
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=

# Robinhood Chain (EVM L2, chain ID 4663) — powers /scanner.
# Comma-separated; the first entry is primary, the rest are failovers.
# Defaults to the public endpoint (rate-limited, no SLA); move to a
# dedicated Alchemy/QuickNode endpoint here without a code change.
ROBINHOOD_RPC_URL=

# Display labels for the chain's gas token. Unverified against the live
# chain, and not used in any calculation — override if they read wrong.
ROBINHOOD_NATIVE_SYMBOL=
ROBINHOOD_NATIVE_NAME=

# Token scanner second opinions. Both default to the public endpoints;
# set a value to an empty string to switch that source off entirely.
# GoPlus Token Security covers Robinhood Chain (chain 4663) and is what
# simulates a buy/sell, which bytecode analysis cannot do.
GOPLUS_API_URL=
# Robinhood Chain's own Blockscout — indexed holder lists and contract
# verification status, neither of which the public RPC can serve.
BLOCKSCOUT_API_URL=

# Optional Blockscout key (dev.blockscout.com) — raises rate limits. The
# client discovers which Blockscout host answers for chain 4663, so
# BLOCKSCOUT_API_URL only needs setting to pin or override it.
BLOCKSCOUT_API_KEY=

# Quick Intel audit (quickintel.io) — a second source for whether
# liquidity is locked or burned, checked against docs.quickintel.io/
# developers/api-supported-chains as of 2026-09: Robinhood Chain (4663)
# is NOT on their supported-chains list yet, so this stays "unavailable"
# regardless of key/chain until they add it. Liquidity is answered today
# by GoPlus instead (see goplus.ts — its response already includes the
# LP token's own holder list, parsed for locked/burned share). Set the
# key below to future-proof for when Quick Intel adds this chain; no
# harm in leaving it unset.
QUICKINTEL_API_KEY=
QUICKINTEL_CHAIN=
# Only needed to override their documented defaults
# (https://api.quickintel.io/v1, header X-QKNTL-KEY).
QUICKINTEL_API_URL=
QUICKINTEL_AUTH_HEADER=

# WalletConnect (/app workspace) — optional. Without it, wallet connect
# still works via any injected wallet (MetaMask etc.); this adds the
# WalletConnect protocol on top. Get a project ID free at
# cloud.walletconnect.com/reown, no other config needed.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# DCA bot vault (/app/bots) — deliberately unset until someone runs
# contracts/script/deploy-dca.mjs with their own key. Never set this to
# a placeholder; the page reads its absence as "not deployed yet" and
# shows that honestly instead of pointing at a fake address.
NEXT_PUBLIC_DCA_VAULT_ADDRESS=

# Own chain indexer (api/cron/index-chain — see supabase/migrations/
# 0001_indexer.sql, which must be applied to the SUPABASE_URL project
# above before this does anything). Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests when
# it's set; generate any random string and set it both here and in
# Vercel's own env vars. Without it the route still works but accepts
# unauthenticated calls — fine for local testing, not for production.
CRON_SECRET=
# Block to start scanning from on a cold start (state.*_synced_to_block
# = 0) — set this to Uniswap V3's factory deployment block on Robinhood
# Chain, once known, to skip pre-DEX history entirely. Defaults to 0
# (scans from genesis), which is correct but slower to catch up.
INDEXER_START_BLOCK=
# eth_getLogs chunks (10,000 blocks each) per cron run, split evenly
# between pool discovery and swap scanning. Each run also stops itself
# on its own ~22s budget per scan regardless of this number — raise it
# only if runs are finishing well under that budget with room to spare.
INDEXER_MAX_CHUNKS_PER_RUN=
