"use client";

import { useState } from "react";
import type { ScanResult } from "@/lib/scan";

type Status = "idle" | "loading" | "error" | "done";

const EXAMPLE_BOTS = [
  { name: "Maestro", trades: 6, fees: 4.67, mark: "M" },
  { name: "Axiom", trades: 0, fees: 0, mark: "A" },
  { name: "BullX", trades: 0, fees: 0, mark: "B" },
  { name: "Trojan", trades: 0, fees: 0, mark: "T" },
  { name: "BonkBot", trades: 0, fees: 0, mark: "B" },
];

export default function Home() {
  const [wallet, setWallet] = useState("");
  const [status, setStatus] = useState<Status>("idle");
  const [error, setError] = useState<string | null>(null);
  const [result, setResult] = useState<ScanResult | null>(null);

  async function handleScan() {
    if (!wallet.trim()) return;

    setStatus("loading");
    setError(null);
    setResult(null);

    try {
      const res = await fetch("/api/scan", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ wallet: wallet.trim() }),
      });

      const data = await res.json();

      if (!res.ok) {
        setError(data.error ?? "Something went wrong");
        setStatus("error");
        return;
      }

      setResult(data as ScanResult);
      setStatus("done");
    } catch {
      setError("Network error — try again");
      setStatus("error");
    }
  }

  return (
    <main className="auevo-site">
      <nav className="auevo-nav">
        <a className="auevo-logo" href="/">auevo</a>

        <div className="auevo-nav-links">
          <a href="#how">How it works</a>
          <a href="#example">Example</a>
          <span className="auevo-nav-status">Solana</span>
        </div>
      </nav>

      <section className="auevo-hero">
        <div className="auevo-eyebrow">
          SAME TRADES. LESS FOR YOU.
        </div>

        <div className="auevo-hero-grid">
          <div className="auevo-hero-copy">
            <h1>
              What did
              <br />
              the bots take
              <br />
              <em>from you?</em>
            </h1>

            <p className="auevo-intro">
              Paste your Solana wallet. We scan 90 days of public history and
              show every fee you paid to trading bots — Axiom, BullX, Trojan,
              BonkBot and the rest.
            </p>

            <div className="auevo-search-shell">
              <span className="solana-mini" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>

              <input
                type="text"
                value={wallet}
                onChange={(e) => setWallet(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && handleScan()}
                placeholder="Paste your Solana wallet address"
                spellCheck={false}
              />

              <button
                onClick={handleScan}
                disabled={status === "loading" || !wallet.trim()}
                aria-label="Scan wallet"
              >
                {status === "loading" ? (
                  <span className="scan-loader" />
                ) : (
                  "→"
                )}
              </button>
            </div>

            {status === "error" && (
              <p className="auevo-error">{error}</p>
            )}

            <div className="auevo-trust-row" id="how">
              <span>◎ No connection</span>
              <span>ϟ Read-only</span>
              <span>▢ No signatures</span>
            </div>
          </div>

          <div className="auevo-hero-art" aria-hidden="true">
            <div className="auevo-note note-top">
              You trade.
              <br />
              They take a cut.
              <span className="note-arrow">↙</span>
            </div>

            <div className="coin coin-back">
              <span>≋</span>
            </div>

            <div className="coin coin-front">
              <span>≋</span>
            </div>

            <div className="auevo-note note-bottom">
              Same markets.
              <br />
              More for you.
            </div>
          </div>
        </div>

        <div className="auevo-data-strip">
          <span>PUBLIC ONCHAIN DATA</span>
          <i />
          <span>READ ONLY</span>
          <i />
          <span>90 DAY SCAN</span>
          <i />
          <span>NO SIGNATURES</span>
        </div>
      </section>

      {status === "done" && result ? (
        <ResultSection result={result} />
      ) : (
        <ExampleSection />
      )}

      <footer className="auevo-footer">
        <div>
          <strong>auevo</strong>
          <span>more transparency for crypto markets.</span>
        </div>

        <div>
          <span>privacy</span>
          <span>terms</span>
          <span>© 2026</span>
        </div>
      </footer>
    </main>
  );
}

function ExampleSection() {
  return (
    <section className="report-section" id="example">
      <div className="report-kicker">
        <span>EXAMPLE RESULT</span>
        <span>THIS IS WHAT YOU&apos;LL SEE</span>
      </div>

      <div className="fee-report example-report">
        <ReportHeader
          wallet="8M9TNzUFY...JfyQvg"
          totalUsd={4.67}
          totalSol={0.047}
          days={90}
        />

        <div className="report-table">
          <div className="report-table-head">
            <span>BOT</span>
            <span>TRADES</span>
            <span>TOTAL FEES</span>
            <span>%</span>
          </div>

          {EXAMPLE_BOTS.map((bot) => (
            <div className="report-row" key={bot.name}>
              <div className="report-bot">
                <span className="bot-mark">{bot.mark}</span>
                <strong>{bot.name}</strong>
              </div>
              <span>{bot.trades}</span>
              <span>${bot.fees.toFixed(2)}</span>
              <div className="report-share">
                <span>{bot.fees > 0 ? "100%" : "0%"}</span>
                <i>
                  <b style={{ width: bot.fees > 0 ? "100%" : "0%" }} />
                </i>
              </div>
            </div>
          ))}
        </div>

        <div className="report-bottom">
          <span>6 bot trades · 14 transactions scanned</span>
          <strong>REAL DATA. NO BS.</strong>
        </div>
      </div>
    </section>
  );
}

function ResultSection({ result }: { result: ScanResult }) {
  const empty = result.totalTxScanned === 0;
  const noFees = !empty && result.breakdown.length === 0;

  return (
    <section className="report-section result-section">
      <div className="report-kicker">
        <span>YOUR RESULT</span>
        <button onClick={() => window.location.reload()}>NEW SCAN ↗</button>
      </div>

      <div className="fee-report receipt-print">
        <ReportHeader
          wallet={shortWallet(result.wallet)}
          totalUsd={result.totalUsd}
          totalSol={result.totalSol}
          days={result.daysScanned}
        />

        {empty ? (
          <div className="report-message">
            No transactions found for this wallet.
          </div>
        ) : noFees ? (
          <div className="report-message">
            No fees to currently tracked bots across{" "}
            {result.totalTxScanned} transactions.
          </div>
        ) : (
          <>
            <div className="report-table">
              <div className="report-table-head">
                <span>BOT</span>
                <span>TRADES</span>
                <span>TOTAL FEES</span>
                <span>%</span>
              </div>

              {result.breakdown.map((bot) => {
                const pct =
                  result.totalUsd > 0
                    ? (bot.usdPaid / result.totalUsd) * 100
                    : 0;

                return (
                  <div className="report-row" key={bot.botKey}>
                    <div className="report-bot">
                      <span className="bot-mark">
                        {bot.name.slice(0, 1).toUpperCase()}
                      </span>
                      <strong>{bot.name}</strong>
                    </div>

                    <span>{bot.txCount}</span>
                    <span>${bot.usdPaid.toFixed(2)}</span>

                    <div className="report-share">
                      <span>{pct.toFixed(0)}%</span>
                      <i>
                        <b
                          style={{
                            width: `${Math.min(100, pct)}%`,
                          }}
                        />
                      </i>
                    </div>
                  </div>
                );
              })}
            </div>

            <div className="report-meta">
              <span>
                {result.totalBotTrades} bot trades ·{" "}
                {result.totalTxScanned} transactions scanned
              </span>
              <span>SOL @ ${result.solPriceUsd.toFixed(2)}</span>
            </div>
          </>
        )}
      </div>

      {!empty && !noFees && (
        <EmailCapture
          wallet={result.wallet}
          totalUsd={result.totalUsd}
        />
      )}
    </section>
  );
}

function ReportHeader({
  wallet,
  totalUsd,
  totalSol,
  days,
}: {
  wallet: string;
  totalUsd: number;
  totalSol: number;
  days: number;
}) {
  return (
    <div className="report-header">
      <div className="report-brand-row">
        <div>
          <strong>auevo</strong>
          <span>FEE REPORT · LAST {days} DAYS</span>
        </div>

        <span>
          {new Date().toLocaleDateString("en-US", {
            month: "short",
            day: "2-digit",
            year: "numeric",
          })}
        </span>
      </div>

      <div className="report-total-row">
        <div>
          <span>WALLET</span>
          <strong>{wallet}</strong>
        </div>

        <div>
          <span>TOTAL BOT FEES</span>
          <strong className="report-money">
            ${totalUsd.toLocaleString("en-US", {
              minimumFractionDigits: 2,
              maximumFractionDigits: 2,
            })}
          </strong>
          <small>{totalSol.toFixed(3)} SOL</small>
        </div>
      </div>
    </div>
  );
}

function EmailCapture({
  wallet,
  totalUsd,
}: {
  wallet: string;
  totalUsd: number;
}) {
  const [email, setEmail] = useState("");
  const [state, setState] = useState<
    "idle" | "sending" | "done" | "error"
  >("idle");

  async function submit() {
    if (!email.trim()) return;

    setState("sending");

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: email.trim(),
          wallet,
          totalUsd,
        }),
      });

      setState(res.ok ? "done" : "error");
    } catch {
      setState("error");
    }
  }

  if (state === "done") {
    return (
      <div className="future-box future-success">
        <strong>You&apos;re on the list.</strong>
        <span>
          We&apos;ll let you know when there&apos;s a better way to trade.
        </span>
      </div>
    );
  }

  return (
    <div className="future-box">
      <div>
        <span className="future-label">WHAT&apos;S NEXT</span>
        <h3>
          Want to know when there&apos;s
          <br />
          a way to stop paying this?
        </h3>
        <p>
          We&apos;re building tools to help you keep more of every trade.
        </p>
      </div>

      <div className="future-form">
        <input
          type="email"
          value={email}
          onChange={(e) => setEmail(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && submit()}
          placeholder="you@example.com"
        />

        <button
          onClick={submit}
          disabled={state === "sending"}
        >
          {state === "sending" ? "…" : "notify me →"}
        </button>

        {state === "error" && (
          <small>Couldn&apos;t save that — try again.</small>
        )}
      </div>
    </div>
  );
}

function shortWallet(wallet: string) {
  if (wallet.length <= 18) return wallet;
  return `${wallet.slice(0, 9)}...${wallet.slice(-6)}`;
}
